{
  "tools": [
    {
      "name": "search_notes",
      "description": "Search synthetic notes and return matching titles.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "scope": {
            "type": "string",
            "enum": [
              "personal",
              "team"
            ]
          }
        },
        "required": [
          "query",
          "scope"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": false
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "matches"
        ],
        "additionalProperties": false
      }
    }
  ]
}
